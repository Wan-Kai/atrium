{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["spikes/**", "apps/ios/AtriumKit/Sources/AtriumRender/Resources/highlight.min.js"],
  "ignoreBinaries": ["pi", "mkfifo", "screencapture", "sips", "swift"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/lint/*.mjs",
        "vitest.mutation.config.ts",
        "apps/ios/Integration/run.mjs",
        "apps/ios/Integration/fixture.ts",
        "apps/ios/Integration/production-rejection.ts",
        "apps/ios/Integration/sync-contract.ts"
      ],
      "ignoreDependencies": ["@stryker-mutator/core", "@stryker-mutator/command-runner"]
    },
    "packages/host": {
      "entry": ["src/entry.ts", "test/**/*.ts", "src/dev/try-pi.ts", "src/dev/task-replay.ts", "src/dev/task-try.ts"]
    },
    "packages/remote-crypto": {
      "entry": ["test/**/*.ts"]
    },
    "apps/relay": {
      "entry": ["src/entry.ts", "test/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/main/main.ts", "src/preload/preload.ts", "e2e/**/*.ts", "e2e/*.cjs"]
    },
    "packages/testkit": {
      "entry": ["src/faux/extension.ts", "src/faux/readme-extension.ts"]
    },
    "packages/pi": {
      "entry": ["test/**/*.ts", "src/auth/login-worker.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.test.{ts,tsx}", "src/**/*.bench.ts"]
    }
  }
}
